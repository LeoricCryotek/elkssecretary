<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         Bank Change Request — Form
         ═══════════════════════════════════════════════════════════ -->
    <record id="view_bank_change_request_form" model="ir.ui.view">
        <field name="name">elks.bank.change.request.form</field>
        <field name="model">elks.bank.change.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_populate_sending"
                            string="Fill Sending Lines"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'draft'"/>
                    <button name="action_populate_requesting"
                            string="Fill Requesting Lines"
                            type="object"
                            class="btn-secondary"
                            invisible="state != 'draft'"/>
                    <button name="action_secretary_sign"
                            string="Secretary Sign &amp; Send"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"
                            confirm="Sign and send this bag to the Treasurer?"/>
                    <button name="action_treasurer_sign"
                            string="Treasurer Sign — Change Returned"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'sent'"
                            confirm="Confirm you have returned the requested change?"/>
                    <button name="action_confirm"
                            string="Secretary Confirm Receipt"
                            type="object"
                            class="btn-success"
                            invisible="state != 'returned'"
                            confirm="Confirm the returned change is correct?"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent,returned,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Request Info">
                            <field name="request_date"/>
                            <field name="secretary_id"/>
                            <field name="treasurer_id"/>
                            <field name="session_id"/>
                        </group>
                        <group string="Totals &amp; Balance">
                            <field name="total_sending"/>
                            <field name="total_requesting"/>
                            <field name="is_balanced" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <!-- Sign-off status -->
                    <group string="Sign-Offs"
                           invisible="state == 'draft'">
                        <group>
                            <field name="secretary_signed"/>
                            <field name="secretary_sign_date"/>
                        </group>
                        <group>
                            <field name="treasurer_signed"/>
                            <field name="treasurer_sign_date"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Sending (Cash Out)" name="sending">
                            <p class="text-muted">
                                Denominations you are putting in the bag for the Treasurer.
                            </p>
                            <field name="sending_ids" nolabel="1"
                                   context="{'default_line_type': 'sending'}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="denomination"/>
                                    <field name="quantity"/>
                                    <field name="face_value"/>
                                    <field name="subtotal" sum="Total Sending"/>
                                    <field name="line_type" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Requesting Back" name="requesting">
                            <p class="text-muted">
                                Denominations you want the Treasurer to return.
                            </p>
                            <field name="requesting_ids" nolabel="1"
                                   context="{'default_line_type': 'requesting'}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="denomination"/>
                                    <field name="quantity"/>
                                    <field name="face_value"/>
                                    <field name="subtotal" sum="Total Requesting"/>
                                    <field name="line_type" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Notes about this change request..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         Bank Change Request — List
         ═══════════════════════════════════════════════════════════ -->
    <record id="view_bank_change_request_list" model="ir.ui.view">
        <field name="name">elks.bank.change.request.list</field>
        <field name="model">elks.bank.change.request</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'">
                <field name="request_date"/>
                <field name="total_sending" sum="Sending"/>
                <field name="total_requesting" sum="Requesting"/>
                <field name="is_balanced" widget="boolean"/>
                <field name="secretary_signed"/>
                <field name="treasurer_signed"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('sent', 'returned')"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         Bank Change Request — Search
         ═══════════════════════════════════════════════════════════ -->
    <record id="view_bank_change_request_search" model="ir.ui.view">
        <field name="name">elks.bank.change.request.search</field>
        <field name="model">elks.bank.change.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="request_date"/>
                <filter string="Open" name="open"
                        domain="[('state', 'not in', ('done', 'cancelled'))]"/>
                <filter string="Completed" name="completed"
                        domain="[('state', '=', 'done')]"/>
                <filter string="Group by Date" name="group_date"
                        context="{'group_by': 'request_date:month'}"/>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         Action
         ═══���═══════════════════════════════════════════════════════ -->
    <record id="action_bank_change_requests" model="ir.actions.act_window">
        <field name="name">Bank Change Requests</field>
        <field name="res_model">elks.bank.change.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Bank Change Request
            </p>
            <p>
                Request denomination exchanges through the Treasurer.
                Specify what you're sending and what you want back.
            </p>
        </field>
    </record>

</odoo>
