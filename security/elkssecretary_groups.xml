<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="res_groups_privilege_elkssec" model="res.groups.privilege">
            <field name="name">Elks Secretary</field>
            <field name="category_id" ref="base.module_category_productivity"/>
            <field name="sequence">80</field>
        </record>

        <record id="group_elkssecretary_user" model="res.groups">
            <field name="name">User (Reception)</field>
            <field name="privilege_id" ref="res_groups_privilege_elkssec"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_elkssecretary_secretary" model="res.groups">
            <field name="name">Secretary</field>
            <field name="privilege_id" ref="res_groups_privilege_elkssec"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('group_elkssecretary_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
