<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         Project Dollar Slip Sheet
         A US Letter (8.5" x 11") sheet containing exactly 4
         identical handwriting slips arranged 2 columns x 2 rows.
         Each slip is portrait, roughly 4.1" wide x 5.3" tall and
         designed to be cut apart on a flat paper cutter using the
         dashed lines down the middle (vertical) and across the
         middle (horizontal) of the sheet.
         ═══════════════════════════════════════════════════════════ -->

    <!-- Custom paperformat: Letter portrait, minimal but safe
         margins, no header line, no header/footer spacing.  This
         replaces the previous use of base.paperformat_us which
         left a fat top margin and crushed the slip vertically. -->
    <record id="paperformat_project_dollar_sheet" model="report.paperformat">
        <field name="name">Project Dollar Slip Sheet (Letter)</field>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_project_dollar_slip_sheet"
            model="ir.actions.report">
        <field name="name">Project Dollar Slips (sheet)</field>
        <field name="model">elks.meeting.money</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">elkssecretary.report_project_dollar_slip_sheet</field>
        <field name="report_file">elkssecretary.report_project_dollar_slip_sheet</field>
        <field name="paperformat_id" ref="paperformat_project_dollar_sheet"/>
    </record>

    <record id="action_report_project_dollar_slip_sheet_html"
            model="ir.actions.report">
        <field name="name">Project Dollar Slips (sheet, HTML)</field>
        <field name="model">elks.meeting.money</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">elkssecretary.report_project_dollar_slip_sheet</field>
        <field name="report_file">elkssecretary.report_project_dollar_slip_sheet</field>
        <field name="paperformat_id" ref="paperformat_project_dollar_sheet"/>
    </record>

    <template id="report_project_dollar_slip_sheet">
        <t t-call="web.html_container">
            <t t-set="settings"
               t-value="env['elks.lodge.settings'].sudo().search([], limit=1)"/>

            <!-- One full page = one sheet = 4 identical slips.
                 The same handwriting slip whether or not a record
                 was selected.  All-table layout for wkhtmltopdf
                 reliability (no flexbox anywhere). -->
            <div class="page"
                 style="font-family: Arial, sans-serif; color: #000;
                        margin: 0; padding: 0;">

                <style>
                    /* ── Sheet: 2 cols x 2 rows of slip cells ─────── */
                    .pd-sheet {
                        width: 100%;
                        border-collapse: collapse;
                        table-layout: fixed;
                        page-break-inside: avoid;
                    }
                    .pd-sheet > tbody > tr > td {
                        width: 50%;
                        height: 5.3in;            /* ~half page tall */
                        vertical-align: top;
                        padding: 0.15in 0.18in;   /* cut-edge safety  */
                        border-right: 1px dashed #666;
                        border-bottom: 1px dashed #666;
                    }
                    .pd-sheet > tbody > tr > td.col-right  { border-right:  none; }
                    .pd-sheet > tbody > tr.row-bottom > td { border-bottom: none; }

                    /* ── Header: logo | name+title | logo ─────────── */
                    .pd-header { width: 100%; border-collapse: collapse;
                                  margin-bottom: 2px; }
                    .pd-header td { border: none; padding: 0;
                                     vertical-align: middle; }
                    .pd-logo { max-height: 42px; max-width: 50px; }
                    .pd-lodge-name { font-size: 13px; margin: 0;
                                      font-weight: bold; text-align: center;
                                      line-height: 1.15; color: #111; }
                    .pd-bpoe { font-size: 9px; color: #555;
                                margin: 0; text-align: center;
                                line-height: 1.1; }
                    .pd-slip-title { font-size: 14px; font-weight: bold;
                                      letter-spacing: 1px;
                                      text-align: center;
                                      margin: 2px 0 0 0;
                                      color: #000;
                                      line-height: 1.15; }
                    .pd-rule { border-top: 1.5px solid #000;
                                margin: 3px 0 6px 0; height: 0;
                                line-height: 0; }

                    /* ── Date ─────────────────────────────────────── */
                    .pd-meta { width: 100%; border-collapse: collapse;
                                margin-bottom: 6px; font-size: 11px; }
                    .pd-meta td { border: none; padding: 0;
                                   vertical-align: middle; }
                    .pd-meta .blank {
                        display: inline-block;
                        border-bottom: 1px solid #000;
                        height: 14px;
                        vertical-align: bottom;
                    }
                    .pd-meta .blank-date { width: 3.0in; }

                    /* ── Money lines: 2 cols x 8 rows (15 lines) ───── */
                    .pd-money { width: 100%; border-collapse: collapse;
                                 table-layout: fixed; }
                    .pd-money > tbody > tr > td.col {
                        width: 50%;
                        vertical-align: top;
                        padding: 0;
                        border: none;
                    }
                    .pd-money > tbody > tr > td.col.left  { padding-right: 4px; }
                    .pd-money > tbody > tr > td.col.right { padding-left:  4px; }

                    .pd-lines { width: 100%; border-collapse: collapse;
                                 table-layout: fixed; }
                    .pd-lines th {
                        font-weight: normal;
                        text-align: left;
                        font-size: 9px;
                        color: #555;
                        padding: 0 2px 1px 2px;
                        border-bottom: 1px solid #999;
                    }
                    .pd-lines td {
                        font-size: 12px;
                        padding: 6px 2px 4px 2px;
                        border-bottom: 1px solid #444;
                        height: 0.42in;             /* big writing line */
                    }
                    .pd-lines .lineno {
                        width: 0.30in;
                        text-align: right;
                        font-size: 10px;
                        color: #666;
                        padding-right: 4px;
                    }
                    .pd-lines .amount {
                        text-align: left;
                        padding-left: 4px;
                    }
                    /* Filler row to balance the right column to 8
                       physical rows when it only has 7 line entries. */
                    .pd-lines tr.filler td {
                        border-bottom: none;
                        height: 0.42in;
                    }

                    /* ── TOTAL row ─────────────────────────────────── */
                    .pd-total { width: 100%; border-collapse: collapse;
                                 margin-top: 6px;
                                 table-layout: fixed; }
                    .pd-total td {
                        border-top: 2px solid #000;
                        padding: 6px 2px 4px 2px;
                        font-weight: bold;
                        font-size: 13px;
                    }
                    .pd-total .label  { width: 0.7in; }
                    .pd-total .amount { width: 2.6in;
                                         border-bottom: 1px solid #000;
                                         padding-left: 6px;
                                         font-weight: normal; }
                    .pd-total .spacer { border-bottom: none; }

                    /* ── Signature ────────────────────────────────── */
                    .pd-sign {
                        margin-top: 0.35in;
                        border-top: 1px solid #000;
                        padding-top: 3px;
                        text-align: center;
                        font-size: 9px;
                        color: #444;
                        letter-spacing: 0.3px;
                    }
                </style>

                <table class="pd-sheet">
                    <tbody>
                        <t t-foreach="[1, 2]" t-as="row">
                            <tr t-attf-class="{{ 'row-bottom' if row == 2 else 'row-top' }}">
                                <t t-foreach="[1, 2]" t-as="col">
                                    <td t-attf-class="{{ 'col-right' if col == 2 else 'col-left' }}">

                                        <!-- ===== HEADER ===== -->
                                        <table class="pd-header">
                                            <tr>
                                                <td style="width: 16%; text-align: center;">
                                                    <t t-if="settings and settings.logo_primary">
                                                        <img t-att-src="image_data_uri(settings.logo_primary)"
                                                             class="pd-logo"
                                                             alt="Elks USA"/>
                                                    </t>
                                                </td>
                                                <td style="padding: 0 6px;">
                                                    <div class="pd-lodge-name">
                                                        <t t-if="settings and settings.name">
                                                            <span t-field="settings.name"/>
                                                        </t>
                                                        <t t-else="">Elks Lodge</t>
                                                        <t t-if="settings and settings.lodge_number">
                                                            #<span t-field="settings.lodge_number"/>
                                                        </t>
                                                    </div>
                                                    <p class="pd-bpoe">
                                                        Benevolent and Protective Order of Elks
                                                    </p>
                                                    <div class="pd-slip-title">
                                                        PROJECT DOLLARS
                                                    </div>
                                                </td>
                                                <td style="width: 16%; text-align: center;">
                                                    <t t-if="settings and settings.logo_lodge">
                                                        <img t-att-src="image_data_uri(settings.logo_lodge)"
                                                             class="pd-logo"
                                                             alt="Lodge Logo"/>
                                                    </t>
                                                </td>
                                            </tr>
                                        </table>
                                        <div class="pd-rule"/>

                                        <!-- ===== DATE ===== -->
                                        <table class="pd-meta">
                                            <tr>
                                                <td>
                                                    <strong>Date:</strong>
                                                    <span class="blank blank-date">&#160;</span>
                                                </td>
                                            </tr>
                                        </table>

                                        <!-- ===== 15 MONEY LINES (8 + 7) ===== -->
                                        <table class="pd-money">
                                            <tr>
                                                <td class="col left">
                                                    <table class="pd-lines">
                                                        <tr>
                                                            <th class="lineno">#</th>
                                                            <th class="amount">Amount</th>
                                                        </tr>
                                                        <t t-foreach="[1, 2, 3, 4, 5, 6, 7, 8]"
                                                           t-as="n">
                                                            <tr>
                                                                <td class="lineno"><t t-esc="n"/></td>
                                                                <td class="amount">$</td>
                                                            </tr>
                                                        </t>
                                                    </table>
                                                </td>
                                                <td class="col right">
                                                    <table class="pd-lines">
                                                        <tr>
                                                            <th class="lineno">#</th>
                                                            <th class="amount">Amount</th>
                                                        </tr>
                                                        <t t-foreach="[9, 10, 11, 12, 13, 14, 15]"
                                                           t-as="n">
                                                            <tr>
                                                                <td class="lineno"><t t-esc="n"/></td>
                                                                <td class="amount">$</td>
                                                            </tr>
                                                        </t>
                                                        <!-- balance right column to 8 rows -->
                                                        <tr class="filler">
                                                            <td class="lineno">&#160;</td>
                                                            <td class="amount">&#160;</td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                        </table>

                                        <!-- ===== TOTAL ===== -->
                                        <table class="pd-total">
                                            <tr>
                                                <td class="label">TOTAL</td>
                                                <td class="amount">$</td>
                                                <td class="spacer">&#160;</td>
                                            </tr>
                                        </table>

                                        <!-- ===== SIGNATURE ===== -->
                                        <div class="pd-sign">
                                            Trustee / Member Signature
                                        </div>
                                    </td>
                                </t>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

</odoo>
