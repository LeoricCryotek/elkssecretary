<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_daily_secretary" model="ir.actions.report">
        <field name="name">Daily Secretary Report</field>
        <field name="model">elks.secretary.dashboard</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">elkssecretary.report_daily_secretary</field>
        <field name="report_file">elkssecretary.report_daily_secretary</field>
        <field name="paperformat_id" ref="base.paperformat_us"/>
    </record>

    <!-- Companion PDF report for download -->
    <record id="action_report_daily_secretary_pdf" model="ir.actions.report">
        <field name="name">Daily Secretary Report (PDF)</field>
        <field name="model">elks.secretary.dashboard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">elkssecretary.report_daily_secretary</field>
        <field name="report_file">elkssecretary.report_daily_secretary</field>
        <field name="paperformat_id" ref="base.paperformat_us"/>
    </record>

    <template id="report_daily_secretary">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="settings" t-value="doc.env['elks.lodge.settings'].sudo().search([], limit=1)"/>
                <t t-set="dept_income" t-value="doc._get_department_income()"/>
                <div class="page" style="font-family: Arial, sans-serif; font-size: 12px;">

                    <!-- Header: logo left, title right -->
                    <table style="width: 100%; margin-bottom: 12px;">
                        <tr>
                            <td style="width: 80px; vertical-align: top;">
                                <t t-if="settings and settings.logo_primary">
                                    <img t-att-src="image_data_uri(settings.logo_primary)"
                                         style="max-height: 70px; max-width: 70px;"
                                         alt="Elks Logo"/>
                                </t>
                            </td>
                            <td style="vertical-align: middle; text-align: center;">
                                <div style="font-size: 20px; font-weight: bold; color: #333;">
                                    Secretary Report —
                                    <t t-if="settings">
                                        <t t-esc="settings.name or 'Elks Lodge'"/>
                                        <t t-if="settings.lodge_number">
                                            #<t t-esc="settings.lodge_number"/>
                                        </t>
                                    </t>
                                </div>
                                <div style="font-size: 12px; color: #888;">
                                    <span t-field="doc.report_date"
                                          t-options='{"widget": "date"}'/>
                                </div>
                            </td>
                            <td style="width: 80px;"/>
                        </tr>
                    </table>

                    <hr style="border-top: 2px solid #1a237e; margin: 0 0 14px 0;"/>

                    <!-- Two-column layout: left = activity, right = income -->
                    <table style="width: 100%; border-collapse: collapse;">
                        <tr>
                            <!-- LEFT COLUMN -->
                            <td style="width: 55%; vertical-align: top; padding-right: 16px;">

                                <h4 style="color: #1a237e; margin: 0 0 6px 0; border-bottom: 1px solid #ddd; padding-bottom: 3px;">
                                    Payments Activity
                                </h4>
                                <table style="width: 100%; font-size: 12px; margin-bottom: 14px;">
                                    <tr>
                                        <td style="padding: 2px 0;">Today's payments:</td>
                                        <td style="padding: 2px 0; text-align: right; width: 50px;">
                                            <span t-field="doc.today_payment_count"/>
                                        </td>
                                        <td style="padding: 2px 0; text-align: right; width: 90px;">
                                            <span t-field="doc.today_payment_amount"
                                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px 0;">Last 7 days:</td>
                                        <td style="padding: 2px 0; text-align: right;">
                                            <span t-field="doc.week_payment_count"/>
                                        </td>
                                        <td style="padding: 2px 0; text-align: right;">
                                            <span t-field="doc.week_payment_amount"
                                                  t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                    </tr>
                                </table>

                                <h4 style="color: #1a237e; margin: 0 0 6px 0; border-bottom: 1px solid #ddd; padding-bottom: 3px;">
                                    Membership Status
                                </h4>
                                <table style="width: 100%; font-size: 12px; margin-bottom: 14px;">
                                    <tr>
                                        <td style="padding: 2px 0;">Proposed members (active pipeline):</td>
                                        <td style="padding: 2px 0; text-align: right;">
                                            <strong><span t-field="doc.proposed_members_count"/></strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px 0;">Initiated – pending CLMS entry:</td>
                                        <td style="padding: 2px 0; text-align: right;">
                                            <strong style="color: #c62828;">
                                                <span t-field="doc.initiated_pending_clms_count"/>
                                            </strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px 0;">Dues expiring (30 days):</td>
                                        <td style="padding: 2px 0; text-align: right;">
                                            <span t-field="doc.members_expiring_30d"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px 0;">Delinquent members:</td>
                                        <td style="padding: 2px 0; text-align: right;">
                                            <strong><span t-field="doc.members_delinquent"/></strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px 0;">New volunteers today:</td>
                                        <td style="padding: 2px 0; text-align: right;">
                                            <span t-field="doc.new_volunteers_today"/>
                                        </td>
                                    </tr>
                                </table>

                                <h4 style="color: #1a237e; margin: 0 0 6px 0; border-bottom: 1px solid #ddd; padding-bottom: 3px;">
                                    Maintenance
                                </h4>
                                <table style="width: 100%; font-size: 12px; margin-bottom: 14px;">
                                    <tr>
                                        <td style="padding: 2px 0;">Open work orders:</td>
                                        <td style="padding: 2px 0; text-align: right;">
                                            <span t-field="doc.open_work_orders"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px 0;">High priority (score ≥ 12):</td>
                                        <td style="padding: 2px 0; text-align: right;">
                                            <strong style="color: #c62828;">
                                                <span t-field="doc.high_priority_maintenance"/>
                                            </strong>
                                        </td>
                                    </tr>
                                </table>

                                <h4 style="color: #1a237e; margin: 0 0 6px 0; border-bottom: 1px solid #ddd; padding-bottom: 3px;">
                                    Purchase Approvals
                                </h4>
                                <table style="width: 100%; font-size: 12px; margin-bottom: 14px;">
                                    <tr>
                                        <td style="padding: 2px 0;">Awaiting Board approval:</td>
                                        <td style="padding: 2px 0; text-align: right;">
                                            <span t-field="doc.board_queue_count"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px 0;">Awaiting Floor vote:</td>
                                        <td style="padding: 2px 0; text-align: right;">
                                            <span t-field="doc.floor_queue_count"/>
                                        </td>
                                    </tr>
                                </table>

                                <h4 style="color: #1a237e; margin: 0 0 6px 0; border-bottom: 1px solid #ddd; padding-bottom: 3px;">
                                    Meeting Money
                                </h4>
                                <table style="width: 100%; font-size: 12px; margin-bottom: 14px;">
                                    <tr>
                                        <td style="padding: 2px 0;">Entries this month:</td>
                                        <td style="padding: 2px 0; text-align: right;">
                                            <span t-field="doc.meeting_money_this_month_count"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px 0;">Project $ YTD (lodge year):</td>
                                        <td style="padding: 2px 0; text-align: right;">
                                            $<span t-field="doc.meeting_money_project_dollars_ytd"/>
                                        </td>
                                    </tr>
                                </table>

                            </td>

                            <!-- RIGHT COLUMN -->
                            <td style="width: 45%; vertical-align: top; padding-left: 16px; border-left: 1px solid #ddd;">

                                <h4 style="color: #1a237e; margin: 0 0 6px 0; border-bottom: 1px solid #ddd; padding-bottom: 3px;">
                                    YTD Department Income
                                </h4>
                                <table style="width: 100%; font-size: 12px; margin-bottom: 14px;">
                                    <t t-foreach="dept_income" t-as="dept">
                                        <tr>
                                            <td style="padding: 3px 0;">
                                                <t t-esc="dept.get('name')"/>:
                                            </td>
                                            <td style="padding: 3px 0; text-align: right; font-weight: bold;">
                                                $<t t-esc="'%.2f' % dept.get('income', 0)"/>
                                            </td>
                                        </tr>
                                    </t>
                                </table>

                                <h4 style="color: #1a237e; margin: 0 0 6px 0; border-bottom: 1px solid #ddd; padding-bottom: 3px;">
                                    Charity Activity (Lodge Year)
                                </h4>
                                <table style="width: 100%; font-size: 12px; margin-bottom: 14px;">
                                    <tr>
                                        <td style="padding: 2px 0;">Active activities:</td>
                                        <td style="padding: 2px 0; text-align: right;">
                                            <span t-field="doc.charity_activity_count"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px 0;">Total volunteer hours:</td>
                                        <td style="padding: 2px 0; text-align: right;">
                                            <span t-field="doc.charity_total_hours"
                                                  t-options='{"widget": "float", "precision": 1}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px 0;">Validated hours:</td>
                                        <td style="padding: 2px 0; text-align: right;">
                                            <span t-field="doc.charity_validated_hours"
                                                  t-options='{"widget": "float", "precision": 1}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px 0;">Total miles:</td>
                                        <td style="padding: 2px 0; text-align: right;">
                                            <span t-field="doc.charity_total_miles"
                                                  t-options='{"widget": "float", "precision": 1}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px 0;">Hours pending validation:</td>
                                        <td style="padding: 2px 0; text-align: right;">
                                            <span t-field="doc.charity_pending_count"/>
                                        </td>
                                    </tr>
                                </table>

                                <h4 style="color: #1a237e; margin: 0 0 6px 0; border-bottom: 1px solid #ddd; padding-bottom: 3px;">
                                    RV Parking (Current)
                                </h4>
                                <t t-set="rv_data" t-value="doc._get_rv_summary()"/>
                                <table style="width: 100%; font-size: 12px; margin-bottom: 14px;">
                                    <tr>
                                        <td style="padding: 2px 0;">Currently parked:</td>
                                        <td style="padding: 2px 0; text-align: right;">
                                            <strong><t t-esc="rv_data.get('currently_parked', 0)"/></strong>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px 0;">Total spaces:</td>
                                        <td style="padding: 2px 0; text-align: right;">
                                            <t t-esc="rv_data.get('total_spaces', 0)"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px 0;">This month registrations:</td>
                                        <td style="padding: 2px 0; text-align: right;">
                                            <t t-esc="rv_data.get('month_registrations', 0)"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 2px 0;">This month collected:</td>
                                        <td style="padding: 2px 0; text-align: right; font-weight: bold;">
                                            $<t t-esc="'%.2f' % rv_data.get('month_collected', 0)"/>
                                        </td>
                                    </tr>
                                </table>

                            </td>
                        </tr>
                    </table>

                    <!-- Footer -->
                    <div style="text-align: center; color: #aaa; font-size: 9px; margin-top: 10px; border-top: 1px solid #ddd; padding-top: 6px;">
                        Generated from the Elks Lodge management system.
                        For questions, contact the Lodge Secretary.
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
