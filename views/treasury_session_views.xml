<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         Treasury Session — Form
         ═══════════════════════════════════════════════════════════ -->
    <record id="view_treasury_session_form" model="ir.ui.view">
        <field name="name">elks.treasury.session.form</field>
        <field name="model">elks.treasury.session</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_add_till"
                            string="Add Till"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_add_safe_count"
                            string="Count Safe"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_close"
                            string="Close Session"
                            type="object"
                            class="btn-success"
                            invisible="state != 'draft'"
                            confirm="This will lock all counts. Continue?"/>
                    <button name="action_reopen"
                            string="Re-open"
                            type="object"
                            invisible="state != 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Session Info">
                            <field name="session_date"/>
                            <field name="secretary_id"/>
                        </group>
                        <group string="Totals">
                            <field name="till_count"/>
                            <field name="total_tills"/>
                            <field name="total_safe"/>
                            <field name="total_change_slips"/>
                            <field name="grand_total"
                                   class="oe_subtotal_footer_separator"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Till Counts" name="tills">
                            <field name="till_count_ids" nolabel="1">
                                <list editable="bottom" create="0">
                                    <field name="till_name"/>
                                    <field name="total_bills"/>
                                    <field name="total_rolled"/>
                                    <field name="total_loose"/>
                                    <field name="total"
                                           decoration-bf="1"
                                           sum="Total All Tills"/>
                                    <field name="counted_by"/>
                                    <field name="state"
                                           widget="badge"
                                           decoration-info="state == 'draft'"
                                           decoration-success="state == 'done'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Safe / Bank" name="safe">
                            <field name="safe_count_ids" nolabel="1">
                                <list editable="bottom" create="0">
                                    <field name="total_bills"/>
                                    <field name="total_rolled"/>
                                    <field name="total_loose"/>
                                    <field name="total"
                                           decoration-bf="1"/>
                                    <field name="counted_by"/>
                                    <field name="state"
                                           widget="badge"
                                           decoration-info="state == 'draft'"
                                           decoration-success="state == 'done'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Change Slips" name="change_slips">
                            <field name="change_slip_ids" nolabel="1">
                                <list>
                                    <field name="slip_date"/>
                                    <field name="requested_by"/>
                                    <field name="total" sum="Total"/>
                                    <field name="approved_by"/>
                                    <field name="state"
                                           widget="badge"
                                           decoration-info="state == 'draft'"
                                           decoration-success="state == 'done'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Session notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         Treasury Session — List
         ═══════════════════════════════════════════════════════════ -->
    <record id="view_treasury_session_list" model="ir.ui.view">
        <field name="name">elks.treasury.session.list</field>
        <field name="model">elks.treasury.session</field>
        <field name="arch" type="xml">
            <list>
                <field name="session_date"/>
                <field name="till_count"/>
                <field name="total_tills" sum="Tills"/>
                <field name="total_safe" sum="Safe"/>
                <field name="grand_total" sum="Grand Total"
                       decoration-bf="1"/>
                <field name="secretary_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         Treasury Session — Search
         ═══════════════════════════════════════════════════════════ -->
    <record id="view_treasury_session_search" model="ir.ui.view">
        <field name="name">elks.treasury.session.search</field>
        <field name="model">elks.treasury.session</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="session_date"/>
                <field name="secretary_id"/>
                <filter string="Open" name="in_progress"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Closed" name="closed"
                        domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="This Month" name="this_month"
                        domain="[('session_date', '&gt;=',
                                  (context_today() - relativedelta(day=1)).strftime('%%Y-%%m-%%d')),
                                 ('session_date', '&lt;',
                                  (context_today() + relativedelta(months=1, day=1)).strftime('%%Y-%%m-%%d'))]"/>
                <filter string="Group by Date" name="group_date"
                        context="{'group_by': 'session_date:month'}"/>
                <filter string="Group by Secretary" name="group_secretary"
                        context="{'group_by': 'secretary_id'}"/>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         Actions
         ═══════════════════════════════════════════════════════════ -->
    <record id="action_treasury_sessions" model="ir.actions.act_window">
        <field name="name">Count Sessions</field>
        <field name="res_model">elks.treasury.session</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_in_progress': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Start a new Treasury Count Session
            </p>
            <p>
                Count out your tills and safe at end of shift,
                shift change, or for special events.
            </p>
        </field>
    </record>

</odoo>
