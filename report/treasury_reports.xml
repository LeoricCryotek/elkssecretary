<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         Change Slip — Printable
         ═══════════════════════════════════════════════════════════ -->
    <record id="action_report_change_slip" model="ir.actions.report">
        <field name="name">Change Slip</field>
        <field name="model">elks.change.slip</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">elkssecretary.report_change_slip</field>
        <field name="report_file">elkssecretary.report_change_slip</field>
        <field name="paperformat_id" ref="base.paperformat_us"/>
        <field name="binding_model_id" ref="model_elks_change_slip"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_change_slip_pdf" model="ir.actions.report">
        <field name="name">Change Slip (PDF)</field>
        <field name="model">elks.change.slip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">elkssecretary.report_change_slip</field>
        <field name="report_file">elkssecretary.report_change_slip</field>
        <field name="paperformat_id" ref="base.paperformat_us"/>
    </record>

    <template id="report_change_slip">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="slip">
                <t t-set="settings" t-value="slip.env['elks.lodge.settings'].sudo().search([], limit=1)"/>
                <div class="page" style="font-family: Arial, sans-serif; font-size: 12px;">

                    <!-- ===== LODGE HEADER WITH LOGOS ===== -->
                    <table style="width: 100%; margin-bottom: 10px; border: none;">
                        <tr>
                            <td style="width: 15%; text-align: center; vertical-align: middle; border: none; padding: 0;">
                                <t t-if="settings and settings.logo_primary">
                                    <img t-att-src="image_data_uri(settings.logo_primary)"
                                         style="max-height: 80px; max-width: 100px;" alt="Elks USA"/>
                                </t>
                            </td>
                            <td style="text-align: center; vertical-align: middle; border: none; padding: 0 10px;">
                                <h2 style="font-size: 22px; margin: 0 0 2px 0; color: #333;">
                                    <t t-if="settings and settings.name"><span t-field="settings.name"/></t>
                                    <t t-else="">Elks Lodge</t>
                                    <t t-if="settings and settings.lodge_number">
                                        #<span t-field="settings.lodge_number"/>
                                    </t>
                                </h2>
                                <p style="color: #777; font-size: 11px; margin: 0;">
                                    Benevolent and Protective Order of Elks
                                </p>
                                <h3 style="font-size: 18px; margin: 6px 0 0 0; color: #003366;">
                                    Change Slip
                                </h3>
                            </td>
                            <td style="width: 15%; text-align: center; vertical-align: middle; border: none; padding: 0;">
                                <t t-if="settings and settings.logo_lodge">
                                    <img t-att-src="image_data_uri(settings.logo_lodge)"
                                         style="max-height: 80px; max-width: 100px;" alt="Lodge Logo"/>
                                </t>
                            </td>
                        </tr>
                    </table>
                    <div style="border-top: 2px solid #003366; margin-bottom: 20px;"/>

                    <!-- Slip details -->
                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 20px;">
                        <tr style="background: #f0f5ff;">
                            <td style="border: 1px solid #ccc; padding: 10px 14px; width: 35%; font-weight: bold; color: #555;">
                                Date / Time
                            </td>
                            <td style="border: 1px solid #ccc; padding: 10px 14px; font-size: 14px;">
                                <t t-esc="slip.request_date" t-options="{'widget': 'datetime'}"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid #ccc; padding: 10px 14px; font-weight: bold; color: #555;">
                                Requested By
                            </td>
                            <td style="border: 1px solid #ccc; padding: 10px 14px; font-size: 14px;">
                                <t t-esc="slip.requested_by"/>
                            </td>
                        </tr>
                        <tr style="background: #f0f5ff;">
                            <td style="border: 1px solid #ccc; padding: 10px 14px; font-weight: bold; color: #555;">
                                Amount
                            </td>
                            <td style="border: 1px solid #ccc; padding: 10px 14px; font-size: 18px; font-weight: bold; color: #003366;">
                                $<t t-esc="'%.2f' % slip.amount"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid #ccc; padding: 10px 14px; font-weight: bold; color: #555;">
                                Cash Received
                            </td>
                            <td style="border: 1px solid #ccc; padding: 10px 14px;">
                                <t t-esc="slip.denomination_received or '—'"/>
                            </td>
                        </tr>
                        <tr style="background: #f0f5ff;">
                            <td style="border: 1px solid #ccc; padding: 10px 14px; font-weight: bold; color: #555;">
                                Change Given
                            </td>
                            <td style="border: 1px solid #ccc; padding: 10px 14px;">
                                <t t-esc="slip.denomination_given or '—'"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="border: 1px solid #ccc; padding: 10px 14px; font-weight: bold; color: #555;">
                                Processed By
                            </td>
                            <td style="border: 1px solid #ccc; padding: 10px 14px;">
                                <t t-esc="slip.approved_by.name if slip.approved_by else '—'"/>
                            </td>
                        </tr>
                    </table>

                    <!-- Signature lines -->
                    <div style="margin-top: 50px;">
                        <table style="width: 100%; border: none;">
                            <tr>
                                <td style="width: 45%; border: none; padding-top: 40px;">
                                    <div style="border-top: 1px solid #333; padding-top: 4px; text-align: center; font-size: 12px; color: #555;">
                                        Requestor Signature
                                    </div>
                                </td>
                                <td style="width: 10%; border: none;"/>
                                <td style="width: 45%; border: none; padding-top: 40px;">
                                    <div style="border-top: 1px solid #333; padding-top: 4px; text-align: center; font-size: 12px; color: #555;">
                                        Cashier Signature
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <t t-if="slip.note">
                        <div style="margin-top: 16px; font-size: 11px; color: #666;">
                            <strong>Notes:</strong> <t t-esc="slip.note"/>
                        </div>
                    </t>

                    <p style="text-align: center; font-size: 10px; color: #aaa; margin-top: 30px;">
                        This document is an official record of the
                        <t t-if="settings and settings.name"><span t-field="settings.name"/></t>
                        <t t-else="">Elks Lodge</t>.
                        Retain for audit purposes.
                    </p>
                </div>
            </t>
        </t>
    </template>

    <!-- ═══════════════════════════════════════════════════════════
         Treasury Session Summary — Printable
         ═══════════════════════════════════════════════════════════ -->
    <record id="action_report_treasury_session" model="ir.actions.report">
        <field name="name">Treasury Count Summary</field>
        <field name="model">elks.treasury.session</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">elkssecretary.report_treasury_session</field>
        <field name="report_file">elkssecretary.report_treasury_session</field>
        <field name="paperformat_id" ref="base.paperformat_us"/>
        <field name="binding_model_id" ref="model_elks_treasury_session"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_treasury_session_pdf" model="ir.actions.report">
        <field name="name">Treasury Count Summary (PDF)</field>
        <field name="model">elks.treasury.session</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">elkssecretary.report_treasury_session</field>
        <field name="report_file">elkssecretary.report_treasury_session</field>
        <field name="paperformat_id" ref="base.paperformat_us"/>
    </record>

    <template id="report_treasury_session">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="session">
                <t t-set="settings" t-value="session.env['elks.lodge.settings'].sudo().search([], limit=1)"/>
                <div class="page" style="font-family: Arial, sans-serif; font-size: 12px;">

                    <!-- ===== LODGE HEADER WITH LOGOS ===== -->
                    <table style="width: 100%; margin-bottom: 10px; border: none;">
                        <tr>
                            <td style="width: 15%; text-align: center; vertical-align: middle; border: none; padding: 0;">
                                <t t-if="settings and settings.logo_primary">
                                    <img t-att-src="image_data_uri(settings.logo_primary)"
                                         style="max-height: 80px; max-width: 100px;" alt="Elks USA"/>
                                </t>
                            </td>
                            <td style="text-align: center; vertical-align: middle; border: none; padding: 0 10px;">
                                <h2 style="font-size: 22px; margin: 0 0 2px 0; color: #333;">
                                    <t t-if="settings and settings.name"><span t-field="settings.name"/></t>
                                    <t t-else="">Elks Lodge</t>
                                    <t t-if="settings and settings.lodge_number">
                                        #<span t-field="settings.lodge_number"/>
                                    </t>
                                </h2>
                                <p style="color: #777; font-size: 11px; margin: 0;">
                                    Benevolent and Protective Order of Elks
                                </p>
                                <h3 style="font-size: 18px; margin: 6px 0 0 0; color: #003366;">
                                    Treasury Count Summary
                                </h3>
                            </td>
                            <td style="width: 15%; text-align: center; vertical-align: middle; border: none; padding: 0;">
                                <t t-if="settings and settings.logo_lodge">
                                    <img t-att-src="image_data_uri(settings.logo_lodge)"
                                         style="max-height: 80px; max-width: 100px;" alt="Lodge Logo"/>
                                </t>
                            </td>
                        </tr>
                    </table>
                    <div style="border-top: 2px solid #003366; margin-bottom: 15px;"/>

                    <!-- Session info line -->
                    <table style="width: 100%; margin-bottom: 15px; border: none; font-size: 14px;">
                        <tr>
                            <td style="border: none;">
                                <strong>Date:</strong>
                                <span t-field="session.session_date"/>
                            </td>
                            <td style="border: none; text-align: center;">
                                <strong>Type:</strong>
                                <t t-esc="dict(session._fields['session_type'].selection).get(session.session_type)"/>
                            </td>
                            <td style="border: none; text-align: right;">
                                <strong>Counted By:</strong>
                                <span t-field="session.counted_by"/>
                            </td>
                        </tr>
                    </table>

                    <!-- Till Counts -->
                    <t t-if="session.till_count_ids">
                        <h4 style="color: #003366; border-bottom: 1px solid #ccc; padding-bottom: 4px; margin: 12px 0 8px;">
                            Till Counts
                        </h4>
                        <t t-foreach="session.till_count_ids" t-as="till">
                            <table style="width: 100%; margin-bottom: 12px; border: none; font-size: 13px;">
                                <tr>
                                    <td style="border: none; font-weight: bold; font-size: 14px;">
                                        <t t-esc="till.till_name"/>
                                    </td>
                                    <td style="border: none; text-align: right; font-weight: bold; font-size: 14px;">
                                        $<t t-esc="'%.2f' % till.total"/>
                                    </td>
                                </tr>
                            </table>
                            <table style="width: 100%; border-collapse: collapse; margin-bottom: 10px; font-size: 11px;">
                                <thead>
                                    <tr style="background: #f0f5ff;">
                                        <th style="padding: 4px 8px; text-align: left; border: 1px solid #ddd;">Denomination</th>
                                        <th style="padding: 4px 8px; text-align: right; border: 1px solid #ddd;">Qty</th>
                                        <th style="padding: 4px 8px; text-align: right; border: 1px solid #ddd;">Value</th>
                                        <th style="padding: 4px 8px; text-align: right; border: 1px solid #ddd;">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="till.denomination_ids.filtered(lambda l: l.quantity > 0)" t-as="line">
                                        <tr>
                                            <td style="padding: 3px 8px; border: 1px solid #eee;">
                                                <t t-esc="dict(line._fields['denomination'].selection).get(line.denomination)"/>
                                            </td>
                                            <td style="padding: 3px 8px; text-align: right; border: 1px solid #eee;">
                                                <t t-esc="line.quantity"/>
                                            </td>
                                            <td style="padding: 3px 8px; text-align: right; border: 1px solid #eee;">
                                                $<t t-esc="'%.2f' % line.face_value"/>
                                            </td>
                                            <td style="padding: 3px 8px; text-align: right; border: 1px solid #eee;">
                                                $<t t-esc="'%.2f' % line.subtotal"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr style="font-weight: bold; background: #f8f8f8;">
                                        <td colspan="3" style="padding: 4px 8px; border: 1px solid #ddd; text-align: right;">
                                            Bills: $<t t-esc="'%.2f' % till.total_bills"/>
                                            &amp;nbsp;|&amp;nbsp;
                                            Rolled: $<t t-esc="'%.2f' % till.total_rolled"/>
                                            &amp;nbsp;|&amp;nbsp;
                                            Loose: $<t t-esc="'%.2f' % till.total_loose"/>
                                        </td>
                                        <td style="padding: 4px 8px; text-align: right; border: 1px solid #ddd;">
                                            $<t t-esc="'%.2f' % till.total"/>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </t>
                    </t>

                    <!-- Safe Count -->
                    <t t-if="session.safe_count_ids">
                        <h4 style="color: #003366; border-bottom: 1px solid #ccc; padding-bottom: 4px; margin: 12px 0 8px;">
                            Safe / Bank Count
                        </h4>
                        <t t-foreach="session.safe_count_ids" t-as="safe">
                            <table style="width: 100%; border-collapse: collapse; margin-bottom: 10px; font-size: 11px;">
                                <thead>
                                    <tr style="background: #f0f5ff;">
                                        <th style="padding: 4px 8px; text-align: left; border: 1px solid #ddd;">Denomination</th>
                                        <th style="padding: 4px 8px; text-align: right; border: 1px solid #ddd;">Qty</th>
                                        <th style="padding: 4px 8px; text-align: right; border: 1px solid #ddd;">Value</th>
                                        <th style="padding: 4px 8px; text-align: right; border: 1px solid #ddd;">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="safe.denomination_ids.filtered(lambda l: l.quantity > 0)" t-as="line">
                                        <tr>
                                            <td style="padding: 3px 8px; border: 1px solid #eee;">
                                                <t t-esc="dict(line._fields['denomination'].selection).get(line.denomination)"/>
                                            </td>
                                            <td style="padding: 3px 8px; text-align: right; border: 1px solid #eee;">
                                                <t t-esc="line.quantity"/>
                                            </td>
                                            <td style="padding: 3px 8px; text-align: right; border: 1px solid #eee;">
                                                $<t t-esc="'%.2f' % line.face_value"/>
                                            </td>
                                            <td style="padding: 3px 8px; text-align: right; border: 1px solid #eee;">
                                                $<t t-esc="'%.2f' % line.subtotal"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr style="font-weight: bold;">
                                        <td colspan="3" style="padding: 4px 8px; border: 1px solid #ddd; text-align: right;">Safe Total:</td>
                                        <td style="padding: 4px 8px; text-align: right; border: 1px solid #ddd;">
                                            $<t t-esc="'%.2f' % safe.total"/>
                                        </td>
                                    </tr>
                                </tfoot>
                            </table>
                        </t>
                    </t>

                    <!-- Grand Total Summary -->
                    <table style="width: 60%; margin: 20px auto; border-collapse: collapse; font-size: 14px;">
                        <tr style="background: #f0f5ff;">
                            <td style="padding: 8px 14px; font-weight: bold; border: 1px solid #ccc;">All Tills:</td>
                            <td style="padding: 8px 14px; text-align: right; border: 1px solid #ccc;">
                                $<t t-esc="'%.2f' % session.total_tills"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 8px 14px; font-weight: bold; border: 1px solid #ccc;">Safe:</td>
                            <td style="padding: 8px 14px; text-align: right; border: 1px solid #ccc;">
                                $<t t-esc="'%.2f' % session.total_safe"/>
                            </td>
                        </tr>
                        <tr style="background: #003366; color: white;">
                            <td style="padding: 10px 14px; font-weight: bold; font-size: 16px; border: 1px solid #003366;">Grand Total:</td>
                            <td style="padding: 10px 14px; text-align: right; font-weight: bold; font-size: 16px; border: 1px solid #003366;">
                                $<t t-esc="'%.2f' % session.grand_total"/>
                            </td>
                        </tr>
                        <t t-if="session.expected_bank">
                            <tr style="background: #f0f5ff;">
                                <td style="padding: 8px 14px; border: 1px solid #ccc;">Expected Bank:</td>
                                <td style="padding: 8px 14px; text-align: right; border: 1px solid #ccc;">
                                    $<t t-esc="'%.2f' % session.expected_bank"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding: 8px 14px; font-weight: bold; border: 1px solid #ccc;">Safe Variance:</td>
                                <td style="padding: 8px 14px; text-align: right; font-weight: bold; border: 1px solid #ccc;"
                                    t-att-style="'color: red;' if session.safe_variance &lt; 0 else 'color: green;'">
                                    $<t t-esc="'%.2f' % session.safe_variance"/>
                                </td>
                            </tr>
                        </t>
                    </table>

                    <!-- Signature lines -->
                    <div style="margin-top: 50px;">
                        <table style="width: 100%; border: none;">
                            <tr>
                                <td style="width: 45%; border: none; padding-top: 40px;">
                                    <div style="border-top: 1px solid #333; padding-top: 4px; text-align: center; font-size: 12px; color: #555;">
                                        Counted By
                                    </div>
                                </td>
                                <td style="width: 10%; border: none;"/>
                                <td style="width: 45%; border: none; padding-top: 40px;">
                                    <div style="border-top: 1px solid #333; padding-top: 4px; text-align: center; font-size: 12px; color: #555;">
                                        Witnessed By
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <p style="text-align: center; font-size: 10px; color: #aaa; margin-top: 30px;">
                        This document is an official record of the
                        <t t-if="settings and settings.name"><span t-field="settings.name"/></t>
                        <t t-else="">Elks Lodge</t>.
                        Retain for audit purposes.
                        &amp;nbsp;|&amp;nbsp;
                        Printed <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%m/%d/%Y %I:%M %p')"/>
                    </p>
                </div>
            </t>
        </t>
    </template>

    <!-- ═══════════════════════════════════════════════════════════
         Bank Change Request — Printable Slip
         ═══════════════════════════════════════════════════════════ -->
    <record id="action_report_bank_change_request" model="ir.actions.report">
        <field name="name">Bank Change Request Slip</field>
        <field name="model">elks.bank.change.request</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">elkssecretary.report_bank_change_request</field>
        <field name="report_file">elkssecretary.report_bank_change_request</field>
        <field name="paperformat_id" ref="base.paperformat_us"/>
        <field name="binding_model_id" ref="model_elks_bank_change_request"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_bank_change_request_pdf" model="ir.actions.report">
        <field name="name">Bank Change Request Slip (PDF)</field>
        <field name="model">elks.bank.change.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">elkssecretary.report_bank_change_request</field>
        <field name="report_file">elkssecretary.report_bank_change_request</field>
        <field name="paperformat_id" ref="base.paperformat_us"/>
    </record>

    <template id="report_bank_change_request">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="req">
                <t t-set="settings" t-value="req.env['elks.lodge.settings'].sudo().search([], limit=1)"/>
                <div class="page" style="font-family: Arial, sans-serif; font-size: 12px;">

                    <!-- ===== LODGE HEADER WITH LOGOS ===== -->
                    <table style="width: 100%; margin-bottom: 10px; border: none;">
                        <tr>
                            <td style="width: 15%; text-align: center; vertical-align: middle; border: none; padding: 0;">
                                <t t-if="settings and settings.logo_primary">
                                    <img t-att-src="image_data_uri(settings.logo_primary)"
                                         style="max-height: 80px; max-width: 100px;" alt="Elks USA"/>
                                </t>
                            </td>
                            <td style="text-align: center; vertical-align: middle; border: none; padding: 0 10px;">
                                <h2 style="font-size: 22px; margin: 0 0 2px 0; color: #333;">
                                    <t t-if="settings and settings.name"><span t-field="settings.name"/></t>
                                    <t t-else="">Elks Lodge</t>
                                    <t t-if="settings and settings.lodge_number">
                                        #<span t-field="settings.lodge_number"/>
                                    </t>
                                </h2>
                                <p style="color: #777; font-size: 11px; margin: 0;">
                                    Benevolent and Protective Order of Elks
                                </p>
                                <h3 style="font-size: 18px; margin: 6px 0 0 0; color: #003366;">
                                    Bank Change Request
                                </h3>
                            </td>
                            <td style="width: 15%; text-align: center; vertical-align: middle; border: none; padding: 0;">
                                <t t-if="settings and settings.logo_lodge">
                                    <img t-att-src="image_data_uri(settings.logo_lodge)"
                                         style="max-height: 80px; max-width: 100px;" alt="Lodge Logo"/>
                                </t>
                            </td>
                        </tr>
                    </table>
                    <div style="border-top: 2px solid #003366; margin-bottom: 15px;"/>

                    <!-- Reference and Date -->
                    <table style="width: 100%; margin-bottom: 15px; border: none; font-size: 14px;">
                        <tr>
                            <td style="border: none;">
                                <strong>Date:</strong>
                                <span t-field="req.request_date"/>
                            </td>
                            <td style="border: none; text-align: right;">
                                <strong>Status:</strong>
                                <span t-field="req.state"/>
                            </td>
                        </tr>
                    </table>

                    <!-- Two-column layout: Sending | Requesting -->
                    <table style="width: 100%; border: none; margin-bottom: 20px;">
                        <tr>
                            <!-- SENDING column -->
                            <td style="width: 48%; vertical-align: top; border: none; padding-right: 10px;">
                                <h4 style="color: #003366; border-bottom: 1px solid #003366; padding-bottom: 4px; margin: 0 0 8px;">
                                    Sending to Treasurer
                                </h4>
                                <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                                    <thead>
                                        <tr style="background: #f0f5ff;">
                                            <th style="padding: 4px 6px; text-align: left; border: 1px solid #ddd;">Denom</th>
                                            <th style="padding: 4px 6px; text-align: right; border: 1px solid #ddd;">Qty</th>
                                            <th style="padding: 4px 6px; text-align: right; border: 1px solid #ddd;">Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="sending_lines" t-value="req.env['elks.bank.change.line'].search([('request_id', '=', req.id), ('line_type', '=', 'sending'), ('quantity', '>', 0)])"/>
                                        <t t-foreach="sending_lines" t-as="line">
                                            <tr>
                                                <td style="padding: 3px 6px; border: 1px solid #eee;">
                                                    <t t-esc="dict(line._fields['denomination'].selection).get(line.denomination)"/>
                                                </td>
                                                <td style="padding: 3px 6px; text-align: right; border: 1px solid #eee;">
                                                    <t t-esc="line.quantity"/>
                                                </td>
                                                <td style="padding: 3px 6px; text-align: right; border: 1px solid #eee;">
                                                    $<t t-esc="'%.2f' % line.subtotal"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                    <tfoot>
                                        <tr style="font-weight: bold; background: #f0f5ff;">
                                            <td colspan="2" style="padding: 4px 6px; border: 1px solid #ddd; text-align: right;">Total:</td>
                                            <td style="padding: 4px 6px; text-align: right; border: 1px solid #ddd;">
                                                $<t t-esc="'%.2f' % req.total_sending"/>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </td>

                            <!-- REQUESTING column -->
                            <td style="width: 48%; vertical-align: top; border: none; padding-left: 10px;">
                                <h4 style="color: #003366; border-bottom: 1px solid #003366; padding-bottom: 4px; margin: 0 0 8px;">
                                    Requesting Back
                                </h4>
                                <table style="width: 100%; border-collapse: collapse; font-size: 11px;">
                                    <thead>
                                        <tr style="background: #f0f5ff;">
                                            <th style="padding: 4px 6px; text-align: left; border: 1px solid #ddd;">Denom</th>
                                            <th style="padding: 4px 6px; text-align: right; border: 1px solid #ddd;">Qty</th>
                                            <th style="padding: 4px 6px; text-align: right; border: 1px solid #ddd;">Subtotal</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="requesting_lines" t-value="req.env['elks.bank.change.line'].search([('request_id', '=', req.id), ('line_type', '=', 'requesting'), ('quantity', '>', 0)])"/>
                                        <t t-foreach="requesting_lines" t-as="line">
                                            <tr>
                                                <td style="padding: 3px 6px; border: 1px solid #eee;">
                                                    <t t-esc="dict(line._fields['denomination'].selection).get(line.denomination)"/>
                                                </td>
                                                <td style="padding: 3px 6px; text-align: right; border: 1px solid #eee;">
                                                    <t t-esc="line.quantity"/>
                                                </td>
                                                <td style="padding: 3px 6px; text-align: right; border: 1px solid #eee;">
                                                    $<t t-esc="'%.2f' % line.subtotal"/>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                    <tfoot>
                                        <tr style="font-weight: bold; background: #f0f5ff;">
                                            <td colspan="2" style="padding: 4px 6px; border: 1px solid #ddd; text-align: right;">Total:</td>
                                            <td style="padding: 4px 6px; text-align: right; border: 1px solid #ddd;">
                                                $<t t-esc="'%.2f' % req.total_requesting"/>
                                            </td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </td>
                        </tr>
                    </table>

                    <!-- Balance check -->
                    <div style="text-align: center; font-size: 14px; font-weight: bold; margin-bottom: 20px;"
                         t-att-style="'color: green;' if req.is_balanced else 'color: red;'">
                        <t t-if="req.is_balanced">BALANCED — Equal Exchange</t>
                        <t t-else="">NOT BALANCED — Sending: $<t t-esc="'%.2f' % req.total_sending"/> vs Requesting: $<t t-esc="'%.2f' % req.total_requesting"/></t>
                    </div>

                    <!-- Dual signature lines -->
                    <div style="margin-top: 40px;">
                        <table style="width: 100%; border: none;">
                            <tr>
                                <td style="width: 45%; border: none; padding-top: 40px;">
                                    <div style="border-top: 1px solid #333; padding-top: 4px; text-align: center; font-size: 12px; color: #555;">
                                        Secretary Signature
                                    </div>
                                    <div style="text-align: center; font-size: 10px; color: #888; margin-top: 2px;">
                                        <t t-if="req.secretary_signed">
                                            Signed: <t t-esc="req.secretary_id.name"/>
                                            — <t t-esc="req.secretary_sign_date" t-options="{'widget': 'datetime'}"/>
                                        </t>
                                    </div>
                                </td>
                                <td style="width: 10%; border: none;"/>
                                <td style="width: 45%; border: none; padding-top: 40px;">
                                    <div style="border-top: 1px solid #333; padding-top: 4px; text-align: center; font-size: 12px; color: #555;">
                                        Treasurer Signature
                                    </div>
                                    <div style="text-align: center; font-size: 10px; color: #888; margin-top: 2px;">
                                        <t t-if="req.treasurer_signed">
                                            Signed: <t t-esc="req.treasurer_id.name"/>
                                            — <t t-esc="req.treasurer_sign_date" t-options="{'widget': 'datetime'}"/>
                                        </t>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <t t-if="req.note">
                        <div style="margin-top: 16px; font-size: 11px; color: #666;">
                            <strong>Notes:</strong> <t t-esc="req.note"/>
                        </div>
                    </t>

                    <p style="text-align: center; font-size: 10px; color: #aaa; margin-top: 30px;">
                        This document is an official record of the
                        <t t-if="settings and settings.name"><span t-field="settings.name"/></t>
                        <t t-else="">Elks Lodge</t>.
                        Place this slip in the bank bag. Retain copy for audit purposes.
                    </p>
                </div>
            </t>
        </t>
    </template>

</odoo>
