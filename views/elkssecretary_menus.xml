<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_elkssecretary_root"
              name="Secretary"
              sequence="50"
              web_icon="elkssecretary,static/description/icon.png"
              groups="group_elkssecretary_user"/>

    <menuitem id="menu_elkssecretary_dashboard"
              name="Daily Dashboard"
              parent="menu_elkssecretary_root"
              action="action_secretary_dashboard"
              sequence="10"/>

    <menuitem id="menu_elkssecretary_clms_queue"
              name="CLMS Work Queue"
              parent="menu_elkssecretary_root"
              action="action_clms_work_queue"
              sequence="20"/>

    <!-- ── Treasury ─────────────────────────────────────────── -->
    <menuitem id="menu_elkssecretary_treasury"
              name="Treasury"
              parent="menu_elkssecretary_root"
              sequence="30"/>

    <!-- House sub-section -->
    <menuitem id="menu_treasury_house"
              name="House"
              parent="menu_elkssecretary_treasury"
              sequence="10"/>

    <menuitem id="menu_treasury_sessions"
              name="Count Sessions"
              parent="menu_treasury_house"
              action="action_treasury_sessions"
              sequence="10"/>

    <menuitem id="menu_treasury_tills"
              name="Till Counts"
              parent="menu_treasury_house"
              action="action_till_counts"
              sequence="20"/>

    <menuitem id="menu_treasury_safe"
              name="Safe Counts"
              parent="menu_treasury_house"
              action="action_safe_counts"
              sequence="30"/>

    <!-- Change Slips -->
    <menuitem id="menu_treasury_change_slips"
              name="Change Slips"
              parent="menu_elkssecretary_treasury"
              action="action_change_slips"
              sequence="20"/>

    <menuitem id="menu_treasury_change_slips_all"
              name="All Change Slips"
              parent="menu_elkssecretary_treasury"
              action="action_change_slips_all"
              sequence="25"
              groups="group_elkssecretary_secretary"/>

    <!-- Bank Change Requests -->
    <menuitem id="menu_treasury_bank_change_requests"
              name="Bank Change Requests"
              parent="menu_elkssecretary_treasury"
              action="action_bank_change_requests"
              sequence="28"/>

    <!-- Bank Deposits (link to existing elksfrs model) -->
    <menuitem id="menu_treasury_bank_deposits"
              name="Bank Deposits"
              parent="menu_elkssecretary_treasury"
              action="elksfrs.action_elks_bank_deposit"
              sequence="30"/>

    <!-- ── Meeting Money ────────────────────────────────────── -->
    <menuitem id="menu_elkssecretary_meeting_money"
              name="Meeting Money"
              parent="menu_elkssecretary_root"
              sequence="40"/>

    <menuitem id="menu_meeting_money_entries"
              name="Meeting Entries"
              parent="menu_elkssecretary_meeting_money"
              action="action_meeting_money"
              sequence="10"/>

    <menuitem id="menu_meeting_money_year_summary"
              name="Lodge Year Totals"
              parent="menu_elkssecretary_meeting_money"
              action="action_meeting_money_year_summary"
              sequence="20"/>

    <menuitem id="menu_meeting_money_print_slips"
              name="Print Project $ Slip Sheet"
              parent="menu_elkssecretary_meeting_money"
              action="action_print_project_dollar_slips_blank"
              sequence="30"/>

    <!-- Reports submenu — other modules inject entries here -->
    <menuitem id="menu_elkssecretary_reports"
              name="Reports"
              parent="menu_elkssecretary_root"
              sequence="50"/>

    <menuitem id="menu_elkssecretary_daily_report"
              name="Secretary Report"
              parent="menu_elkssecretary_reports"
              action="action_print_secretary_report"
              sequence="10"/>

    <menuitem id="menu_elkssecretary_charity_report"
              name="Charitable Giving Report"
              parent="menu_elkssecretary_reports"
              action="elkscharity.action_grand_lodge_report_wizard"
              sequence="20"/>
</odoo>
