    <!-- Alphabetize-all-App-Menus server action + menu item.
         Moved here from elkscontacts because it's a secretary-side
         admin utility, not a contacts feature. Idempotent — safe to
         re-run when new modules are installed. -->
    <record id="ir_actions_server_alphabetize_top_menus"
            model="ir.actions.server">
        <field name="name">Alphabetize App Menus</field>
        <field name="model_id" ref="base.model_ir_ui_menu"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
# Odoo's safe_eval forbids direct attribute assignment (STORE_ATTR),
# so we must use .write({...}) — not `m.sequence = ...`.
Menu = env['ir.ui.menu'].sudo()
top_menus = Menu.search([('parent_id', '=', False)])
sorted_menus = top_menus.sorted(key=lambda m: (m.name or '').lower())
changed = 0
for idx, m in enumerate(sorted_menus, start=1):
    new_seq = idx * 10
    if m.sequence != new_seq:
        m.write({'sequence': new_seq})
        changed += 1
action = {
    'type': 'ir.actions.client',
    'tag': 'display_notification',
    'params': {
        'title': 'App Menus Re-Sorted',
        'message': (
            '%s of %s top-level menus updated to alphabetical order. '
            'Hard-refresh your browser (Cmd/Ctrl+Shift+R) to see the '
            'new order.'
        ) % (changed, len(sorted_menus)),
        'type': 'success',
        'sticky': True,
    }
}
        ]]></field>
    </record>

    <menuitem id="menu_elkssecretary_alphabetize_menus"
              name="Alphabetize App Menus"
              parent="menu_elkssecretary_tools"
              action="elkssecretary.ir_actions_server_alphabetize_top_menus"
              sequence="10"/>
