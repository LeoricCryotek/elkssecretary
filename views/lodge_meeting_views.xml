<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ════════ Meeting Form ════════ -->
    <record id="view_lodge_meeting_form" model="ir.ui.view">
        <field name="name">elks.lodge.meeting.form</field>
        <field name="model">elks.lodge.meeting</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_download_docx"
                            string="Download Agenda (Word)"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_generate_minutes"
                            string="Generate Minutes"
                            type="object" class="btn-primary"
                            help="Locks the meeting, generates the final minutes docx from everything you've entered, and syncs Meeting Money.  Press this AFTER the meeting when statuses/motion names/close time are filled in."
                            confirm="Generate the final meeting minutes?  This will lock the record — you can re-open later if needed."/>
                    <button name="action_repopulate_from_system"
                            string="Refresh from System"
                            type="object" class="btn-secondary"
                            invisible="state != 'draft'"
                            confirm="Re-pull Officers, Committees, Propositions, Bills, and auto-generated Deaths/Events?  Manual notes you typed will be kept."/>
                    <button name="action_reopen"
                            string="Re-open"
                            type="object"
                            invisible="state != 'finalized'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,finalized"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Meeting">
                            <field name="meeting_date"/>
                            <field name="prior_meeting_id"
                                   options="{'no_create': True}"/>
                            <field name="exalted_ruler_name"/>
                            <field name="open_time"/>
                            <field name="close_time"/>
                        </group>
                        <group string="Attendance">
                            <field name="members_present_open"/>
                            <field name="members_present_close"/>
                            <field name="minutes_read_by"/>
                            <field name="minutes_accepted"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>

                    <group string="Meeting Money">
                        <group>
                            <field name="project_dollars_amount"/>
                            <field name="fines_amount"/>
                        </group>
                        <group>
                            <field name="meeting_money_id"
                                   readonly="1"
                                   options="{'no_create': True}"/>
                            <label for="meeting_money_id" string=" "/>
                            <div class="text-muted small">
                                Auto-linked when a Meeting Money record
                                exists for this date; created on Finalize
                                if not.
                            </div>
                        </group>
                    </group>

                    <group string="Treasurer's Report">
                        <group>
                            <field name="bills_amount"/>
                            <field name="assets_amount"/>
                            <field name="liabilities_amount"/>
                        </group>
                        <group>
                            <field name="equity_amount"/>
                            <field name="total_le_amount" readonly="1"/>
                            <field name="bills_motion_by"/>
                            <field name="bills_seconded_by"/>
                        </group>
                    </group>

                    <!-- Bills tables rendered OUTSIDE the Treasurer's
                         Report <group> so they use the sheet's full
                         width instead of being clipped inside a
                         nested group's colspan.  Section titles come
                         from <separator>. -->
                    <separator string="Bills from Floor-Vote Queue"/>
                    <field name="bill_ids" nolabel="1" widget="many2many">
                        <list>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="date_order"/>
                            <field name="amount_total" sum="Total"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>

                    <separator string="Additional / Manual Bills"/>
                    <field name="manual_bill_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="description"/>
                            <field name="vendor"/>
                            <field name="amount" sum="Total"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>

                    <notebook>
                        <page string="Officer Roll Call" name="officers">
                            <field name="officer_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="position"/>
                                    <field name="officer_name"/>
                                    <!-- Plain Selection renders as an
                                         inline dropdown in the editable
                                         list — click a cell → dropdown of
                                         Present / Absent / Excused. -->
                                    <field name="status"/>
                                </list>
                            </field>
                            <!-- Substitutions O2m rendered OUTSIDE a
                                 <group> so it uses the notebook page's
                                 full width instead of being squeezed
                                 into half a group cell.  The <separator>
                                 provides the section title. -->
                            <separator string="Substitutions / Fill-Ins"/>
                            <field name="substitution_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence"
                                           widget="handle"/>
                                    <field name="officer_id"
                                           options="{'no_create': True}"/>
                                    <field name="absent_officer_name"
                                           readonly="1"
                                           optional="show"/>
                                    <field name="substitute_id"
                                           options="{'no_create': True}"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                            <separator string="Visitors &amp; Honorees"/>
                            <field name="visitors_note" nolabel="1"
                                   placeholder="Former ERs, honorees, visitors recognized during the meeting…"/>
                        </page>
                        <page string="Members" name="members">
                            <!-- Text fields rendered OUTSIDE a <group>
                                 so they use the notebook page's full
                                 width instead of being squeezed into
                                 the group's 2-column grid.  Section
                                 titles come from <separator>. -->
                            <separator string="Sickness &amp; Distress"/>
                            <field name="sickness_distress" nolabel="1"
                                   placeholder="One per line…"/>
                            <separator string="Deaths of Members"/>
                            <field name="deaths_of_members" nolabel="1"
                                   placeholder="One per line…"/>
                        </page>
                        <page string="Membership Items" name="propositions">
                            <field name="proposition_ids">
                                <list editable="bottom">
                                    <field name="section"/>
                                    <field name="candidate_name"/>
                                    <field name="city_state"/>
                                    <field name="employer"/>
                                    <field name="occupation"/>
                                    <field name="sponsor"/>
                                    <field name="will_be_inducted"
                                           widget="boolean_toggle"
                                           string="Inducted Tonight"/>
                                </list>
                            </field>
                            <div class="text-muted" colspan="2">
                                <p>
                                    Tick <em>Inducted Tonight</em> on any
                                    candidate being inducted at this
                                    meeting.  They'll appear in the
                                    "Members to be Inducted" table on the
                                    printed agenda.  Balloting candidates
                                    start unchecked (waiting on the vote)
                                    and Elected candidates start checked
                                    (they've already won the ballot).
                                </p>
                            </div>
                        </page>
                        <page string="Community &amp; Communications" name="community">
                            <separator string="Community Activities"/>
                            <field name="community_activities" nolabel="1"
                                   placeholder="Upcoming events, one per line…"/>
                            <separator string="Reading of Communications"/>
                            <field name="communications" nolabel="1"
                                   placeholder="Mail / email items to read…"/>
                        </page>
                        <page string="Committees" name="committees">
                            <field name="committee_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="committee_id"
                                           options="{'no_create_edit': True}"
                                           optional="show"/>
                                    <field name="committee_name"/>
                                    <field name="chairperson_id"
                                           options="{'no_create': True}"/>
                                    <field name="chairperson"
                                           optional="hide"/>
                                    <field name="report_text"/>
                                </list>
                            </field>
                        </page>
                        <page string="Business" name="business">
                            <separator string="Unfinished Business"/>
                            <field name="unfinished_business" nolabel="1"
                                   placeholder="One item per line…"/>
                            <separator string="New Business"/>
                            <field name="new_business" nolabel="1"
                                   placeholder="One item per line…"/>
                            <separator string="Good of the Order"/>
                            <field name="good_of_order" nolabel="1"
                                   placeholder="Announcements, recognitions, birthdays…"/>
                            <!-- Motions Requiring Vote — floor motions
                                 that need a mover, seconder, and
                                 pass/fail.  Full-width outside a <group>
                                 so all six columns render legibly. -->
                            <separator string="Motions Requiring Vote"/>
                            <field name="motion_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence"
                                           widget="handle"/>
                                    <field name="section"/>
                                    <field name="description"/>
                                    <field name="motion_by_id"
                                           options="{'no_create': True}"/>
                                    <field name="seconded_by_id"
                                           options="{'no_create': True}"/>
                                    <field name="result"/>
                                    <field name="vote_notes"
                                           optional="show"/>
                                </list>
                            </field>
                            <div class="text-muted" colspan="2">
                                <p>
                                    Add a row for any motion made on
                                    the floor.  Leave <em>Result</em>
                                    blank while the vote is still to be
                                    called — fill it in
                                    (Passed / Failed / Tabled /
                                    Withdrawn) after the vote.  Motions
                                    print on the finalized minutes with
                                    the mover, seconder, and result.
                                </p>
                            </div>
                        </page>
                        <page string="Generated Docs" name="output">
                            <group string="Agenda (pre-meeting draft)">
                                <field name="agenda_docx"
                                       filename="agenda_docx_filename"/>
                                <field name="agenda_docx_filename" invisible="1"/>
                            </group>
                            <group string="Minutes (finalized after meeting)">
                                <field name="minutes_docx"
                                       filename="minutes_docx_filename"/>
                                <field name="minutes_docx_filename" invisible="1"/>
                                <field name="minutes_generated_date"
                                       readonly="1"/>
                                <field name="minutes_generated_by"
                                       readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ════════ Meeting List ════════ -->
    <record id="view_lodge_meeting_list" model="ir.ui.view">
        <field name="name">elks.lodge.meeting.list</field>
        <field name="model">elks.lodge.meeting</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'draft'"
                  decoration-success="state == 'finalized'">
                <field name="meeting_date"/>
                <field name="name"/>
                <field name="exalted_ruler_name"/>
                <field name="members_present_open" string="Members"/>
                <field name="project_dollars_amount"/>
                <field name="fines_amount"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'finalized'"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ════════ Meeting Search ════════ -->
    <record id="view_lodge_meeting_search" model="ir.ui.view">
        <field name="name">elks.lodge.meeting.search</field>
        <field name="model">elks.lodge.meeting</field>
        <field name="arch" type="xml">
            <search>
                <field name="meeting_date"/>
                <field name="exalted_ruler_name"/>
                <filter string="Draft" name="draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Finalized" name="finalized"
                        domain="[('state', '=', 'finalized')]"/>
            </search>
        </field>
    </record>

    <record id="action_lodge_meetings" model="ir.actions.act_window">
        <field name="name">Lodge Meetings</field>
        <field name="res_model">elks.lodge.meeting</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Generate your first meeting agenda
            </p>
            <p>
                Click <em>Generate Agenda</em> from the menu, pick a
                meeting date, and the system pre-populates propositions,
                events, Meeting Money, deaths, and the officer roll call.
            </p>
        </field>
    </record>

    <!-- ════════ Generate Wizard ════════ -->
    <record id="view_lodge_meeting_generate_form" model="ir.ui.view">
        <field name="name">elks.lodge.meeting.generate.form</field>
        <field name="model">elks.lodge.meeting.generate</field>
        <field name="arch" type="xml">
            <form string="Generate Meeting Agenda">
                <group>
                    <field name="meeting_date"/>
                    <field name="reuse_existing"/>
                </group>
                <div class="text-muted">
                    <p>
                        Auto-populates from Meeting Money,
                        Membership Applications, Deaths queue, and
                        Upcoming Events.  You'll land on the agenda
                        form to review and edit before downloading.
                    </p>
                </div>
                <footer>
                    <button name="action_generate" type="object"
                            string="Generate" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_generate_meeting_wizard" model="ir.actions.act_window">
        <field name="name">Generate Meeting Agenda</field>
        <field name="res_model">elks.lodge.meeting.generate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
