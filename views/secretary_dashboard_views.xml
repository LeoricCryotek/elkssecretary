<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_secretary_dashboard_form" model="ir.ui.view">
        <field name="name">elks.secretary.dashboard.form</field>
        <field name="model">elks.secretary.dashboard</field>
        <field name="arch" type="xml">
            <form string="Secretary Dashboard" create="false" edit="false" delete="false">
                <header>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Secretary Daily Dashboard</h1>
                        <p class="text-muted">
                            <field name="report_date" readonly="1"/>
                        </p>
                    </div>

                    <!-- Row 1: CLMS work queue -->
                    <h3 class="mt-3">CLMS Processing Queue</h3>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="card border-warning">
                                <div class="card-body">
                                    <h6 class="text-muted">Payments Pending CLMS Entry</h6>
                                    <h1 class="text-warning">
                                        <field name="clms_pending_count"/>
                                    </h1>
                                    <p>
                                        Total $<field name="clms_pending_amount" widget="monetary"/>
                                        awaiting entry
                                    </p>
                                    <button name="action_open_clms_queue"
                                            type="object"
                                            string="Open Queue →"
                                            class="btn btn-warning"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-info">
                                <div class="card-body">
                                    <h6 class="text-muted">Proposed Members (Active)</h6>
                                    <h1 class="text-info">
                                        <field name="proposed_members_count"/>
                                    </h1>
                                    <p>In pipeline (proposed → elected)</p>
                                    <button name="action_open_proposed_members"
                                            type="object"
                                            string="View Pipeline →"
                                            class="btn btn-info"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-danger">
                                <div class="card-body">
                                    <h6 class="text-muted">Initiated – Needs CLMS</h6>
                                    <h1 class="text-danger">
                                        <field name="initiated_pending_clms_count"/>
                                    </h1>
                                    <p>No member number assigned</p>
                                    <button name="action_open_initiated_pending_clms"
                                            type="object"
                                            string="Enter in CLMS →"
                                            class="btn btn-danger"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 1a: Maintenance -->
                    <div class="row g-3 mt-3">
                        <div class="col-md-6">
                            <div class="card border-primary">
                                <div class="card-body">
                                    <h6 class="text-muted">Open Work Orders</h6>
                                    <h1 class="text-primary">
                                        <field name="open_work_orders"/>
                                    </h1>
                                    <p>
                                        <field name="high_priority_maintenance"/>
                                        high-priority (score ≥ 12)
                                    </p>
                                    <button name="action_open_maintenance"
                                            type="object"
                                            string="Open Maintenance →"
                                            class="btn btn-primary"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 1b: Charity Reporting -->
                    <h3 class="mt-4">Charity Reporting</h3>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="card border-success">
                                <div class="card-body">
                                    <h6 class="text-muted">
                                        Active Activities
                                    </h6>
                                    <h1 class="text-success">
                                        <field name="charity_activity_count"/>
                                    </h1>
                                    <p>Charity tasks this lodge year</p>
                                    <button name="action_open_charity_activities"
                                            type="object"
                                            string="View Activities →"
                                            class="btn btn-success"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-info">
                                <div class="card-body">
                                    <h6 class="text-muted">
                                        Total Hours
                                    </h6>
                                    <h1 class="text-info">
                                        <field name="charity_total_hours"
                                               widget="float_time"/>
                                    </h1>
                                    <p>Logged this lodge year</p>
                                    <button name="action_open_all_charity_hours"
                                            type="object"
                                            string="View All Hours →"
                                            class="btn btn-info"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-secondary">
                                <div class="card-body">
                                    <h6 class="text-muted">
                                        Total Miles
                                    </h6>
                                    <h1 class="text-secondary">
                                        <field name="charity_total_miles"
                                               widget="float" digits="[10,1]"/>
                                    </h1>
                                    <p>Round-trip miles this year</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 mt-2">
                        <div class="col-md-4">
                            <div class="card border-primary">
                                <div class="card-body">
                                    <h6 class="text-muted">
                                        Validated Hours
                                    </h6>
                                    <h1 class="text-primary">
                                        <field name="charity_validated_hours"
                                               widget="float_time"/>
                                    </h1>
                                    <p>Ready for GL Report</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-warning">
                                <div class="card-body">
                                    <h6 class="text-muted">
                                        Awaiting Validation
                                    </h6>
                                    <h1 class="text-warning">
                                        <field name="charity_pending_count"/>
                                    </h1>
                                    <p>Needs Secretary review</p>
                                    <button name="action_open_charity_validation"
                                            type="object"
                                            string="Validate Hours →"
                                            class="btn btn-warning"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 2: payments -->
                    <h3 class="mt-4">Payments</h3>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="card border-success">
                                <div class="card-body">
                                    <h6 class="text-muted">Today</h6>
                                    <h1 class="text-success">
                                        <field name="today_payment_count"/>
                                    </h1>
                                    <p>
                                        <field name="today_payment_amount" widget="monetary"/>
                                        received today
                                    </p>
                                    <button name="action_open_today_payments"
                                            type="object"
                                            string="View Today's Payments →"
                                            class="btn btn-success"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card border-info">
                                <div class="card-body">
                                    <h6 class="text-muted">Last 7 Days</h6>
                                    <h1 class="text-info">
                                        <field name="week_payment_count"/>
                                    </h1>
                                    <p>
                                        <field name="week_payment_amount" widget="monetary"/>
                                        in the past week
                                    </p>
                                    <button name="action_open_week_payments"
                                            type="object"
                                            string="View Week →"
                                            class="btn btn-info"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 3: Purchase Approvals (Budget Transfers removed) -->
                    <h3 class="mt-4">Purchase Approvals</h3>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="card border-primary">
                                <div class="card-body">
                                    <h6 class="text-muted">Board Approval Queue</h6>
                                    <h1 class="text-primary">
                                        <field name="board_queue_count"/>
                                    </h1>
                                    <button name="action_open_board_queue"
                                            type="object"
                                            string="View Board Queue →"
                                            class="btn btn-primary"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card border-info">
                                <div class="card-body">
                                    <h6 class="text-muted">Floor Vote Queue</h6>
                                    <h1 class="text-info">
                                        <field name="floor_queue_count"/>
                                    </h1>
                                    <button name="action_open_floor_queue"
                                            type="object"
                                            string="View Floor Queue →"
                                            class="btn btn-info"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 3b: Meeting Money -->
                    <h3 class="mt-4">Meeting Money</h3>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="card border-success">
                                <div class="card-body">
                                    <h6 class="text-muted">Project $ YTD (Lodge Year)</h6>
                                    <h1 class="text-success">
                                        <field name="meeting_money_project_dollars_ytd"
                                               widget="monetary"/>
                                    </h1>
                                    <p>Cumulative Project Dollars collected this lodge year</p>
                                    <button name="action_open_meeting_money"
                                            type="object"
                                            string="View All Entries →"
                                            class="btn btn-success"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card border-info">
                                <div class="card-body">
                                    <h6 class="text-muted">Entries This Month</h6>
                                    <h1 class="text-info">
                                        <field name="meeting_money_this_month_count"/>
                                    </h1>
                                    <p>Meeting Money records logged this calendar month</p>
                                    <button name="action_open_meeting_money_this_month"
                                            type="object"
                                            string="View This Month →"
                                            class="btn btn-info"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Row 4: membership -->
                    <h3 class="mt-4">Membership</h3>
                    <div class="row g-3">
                        <div class="col-md-4">
                            <div class="card border-warning">
                                <div class="card-body">
                                    <h6 class="text-muted">Dues Expiring (30 days)</h6>
                                    <h1 class="text-warning">
                                        <field name="members_expiring_30d"/>
                                    </h1>
                                    <button name="action_open_expiring"
                                            type="object"
                                            string="View Members →"
                                            class="btn btn-warning"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-danger">
                                <div class="card-body">
                                    <h6 class="text-muted">Delinquent Members</h6>
                                    <h1 class="text-danger">
                                        <field name="members_delinquent"/>
                                    </h1>
                                    <button name="action_open_delinquent"
                                            type="object"
                                            string="View Delinquent →"
                                            class="btn btn-danger"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card border-success">
                                <div class="card-body">
                                    <h6 class="text-muted">New Volunteers Today</h6>
                                    <h1 class="text-success">
                                        <field name="new_volunteers_today"/>
                                    </h1>
                                    <button name="action_open_volunteers_today"
                                            type="object"
                                            string="View →"
                                            class="btn btn-success"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <field name="currency_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_secretary_dashboard" model="ir.actions.server">
        <field name="name">Secretary Dashboard</field>
        <field name="model_id" ref="model_elks_secretary_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_dashboard()</field>
    </record>

    <record id="action_print_secretary_report" model="ir.actions.server">
        <field name="name">Secretary Report</field>
        <field name="model_id" ref="model_elks_secretary_dashboard"/>
        <field name="state">code</field>
        <field name="code">action = model.action_print_secretary_report()</field>
    </record>
</odoo>
