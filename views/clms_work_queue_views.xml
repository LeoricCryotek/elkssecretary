<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dedicated CLMS Work Queue action + view -->
    <record id="action_clms_work_queue" model="ir.actions.act_window">
        <field name="name">CLMS Work Queue</field>
        <field name="res_model">elks.dues.payment</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'posted'), ('clms_status', '=', 'pending')]</field>
        <field name="context">{'search_default_group_date': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nothing to process in CLMS. Nice work!
            </p>
        </field>
    </record>

    <!-- Bulk action: "Mark selected as Processed in CLMS" -->
    <record id="action_bulk_mark_clms_processed" model="ir.actions.server">
        <field name="name">Mark as Processed in CLMS</field>
        <field name="model_id" ref="elksfrs.model_elks_dues_payment"/>
        <field name="binding_model_id" ref="elksfrs.model_elks_dues_payment"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = env['elks.secretary.dashboard'].action_bulk_mark_processed()
        </field>
    </record>
</odoo>
